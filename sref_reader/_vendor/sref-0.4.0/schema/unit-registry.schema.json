{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sref:schema:unit-registry:0.2.0",
  "title": "SREF unit registry 0.2.0",
  "type": "object",
  "required": [
    "version",
    "units"
  ],
  "properties": {
    "version": {
      "const": "0.2.0"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "unitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
      "maxLength": 255
    },
    "signedRational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*|[1-9][0-9]*/[1-9][0-9]*)$",
      "maxLength": 128
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "label": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortText"
        },
        "plural": {
          "$ref": "#/$defs/shortText"
        },
        "symbols": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        }
      },
      "additionalProperties": false
    },
    "aliasSet": {
      "type": "object",
      "required": [
        "language",
        "forms",
        "case_sensitive"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 255
        },
        "forms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        },
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "base"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "base_unit",
            "multiplier",
            "exact"
          ],
          "properties": {
            "kind": {
              "const": "linear"
            },
            "base_unit": {
              "$ref": "#/$defs/unitId"
            },
            "multiplier": {
              "$ref": "#/$defs/signedRational"
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "base_unit",
            "multiplier",
            "offset",
            "exact"
          ],
          "properties": {
            "kind": {
              "const": "affine"
            },
            "base_unit": {
              "$ref": "#/$defs/unitId"
            },
            "multiplier": {
              "$ref": "#/$defs/signedRational"
            },
            "offset": {
              "$ref": "#/$defs/signedRational"
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status",
        "labels"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/unitId"
        },
        "kind": {
          "enum": [
            "physical",
            "count",
            "container"
          ]
        },
        "dimension": {
          "enum": [
            "mass",
            "volume",
            "temperature",
            "length"
          ]
        },
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "ucum": {
          "$ref": "#/$defs/shortText"
        },
        "regions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Z]{2}|[0-9]{3})$"
          }
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1000,
          "propertyNames": {
            "minLength": 2,
            "maxLength": 255
          },
          "additionalProperties": {
            "$ref": "#/$defs/label"
          }
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/aliasSet"
          }
        },
        "status": {
          "enum": [
            "active",
            "deprecated"
          ]
        },
        "replacement": {
          "$ref": "#/$defs/unitId"
        },
        "references": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 10000
          }
        },
        "notes": {
          "$ref": "#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "physical"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "dimension",
              "definition",
              "references"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "count",
                  "container"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "dimension"
                  ]
                },
                {
                  "required": [
                    "definition"
                  ]
                },
                {
                  "required": [
                    "ucum"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "replacement"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": ["status"]
          },
          "then": {
            "not": {
              "required": ["replacement"]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
