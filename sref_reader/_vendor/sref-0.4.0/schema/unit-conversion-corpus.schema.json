{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sref:schema:unit-conversion-corpus:0.2.0",
  "title": "SREF unit conversion conformance corpus 0.2.0",
  "type": "object",
  "required": ["unit_registry", "cases"],
  "properties": {
    "unit_registry": {"type": "string", "minLength": 1, "maxLength": 255},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
    "unitId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
    "signedRational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*|[1-9][0-9]*/[1-9][0-9]*)$",
      "maxLength": 128
    },
    "exactAmount": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"$ref": "#/$defs/signedRational"},
        "approximate": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rangeAmount": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/signedRational"},
        "max": {"$ref": "#/$defs/signedRational"},
        "approximate": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "amount": {
      "oneOf": [
        {"$ref": "#/$defs/exactAmount"},
        {"$ref": "#/$defs/rangeAmount"}
      ]
    },
    "success": {
      "type": "object",
      "required": ["amount", "approximate"],
      "properties": {
        "amount": {"$ref": "#/$defs/amount"},
        "approximate": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "enum": ["unknown-unit", "nonphysical-unit", "incompatible-dimension"]
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "source_unit", "target_unit", "input", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_unit": {"$ref": "#/$defs/unitId"},
        "target_unit": {"$ref": "#/$defs/unitId"},
        "input": {"$ref": "#/$defs/amount"},
        "expected": {
          "oneOf": [
            {"$ref": "#/$defs/success"},
            {"$ref": "#/$defs/failure"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
